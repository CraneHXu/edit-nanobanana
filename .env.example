# 部署模式
# local: 本地开发，启用 AI 功能
# vercel: Vercel 部署，禁用 AI 功能
NEXT_PUBLIC_DEPLOY_TARGET=local

# PaddleOCR API 配置
OCR_API_URL=https://ddq659q3sbt2h5h6.aistudio-app.com/ocr
OCR_API_TOKEN=your_paddle_ocr_token_here

# AI inpaint 后端配置
# 仅在 NEXT_PUBLIC_DEPLOY_TARGET=local 时使用
INPAINT_PROVIDER=iopaint
INPAINT_API_URL=http://127.0.0.1:8080/api/v1/inpaint
INPAINT_API_TOKEN=
